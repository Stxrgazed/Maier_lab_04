def validateNumbers(num1, num2):
    if num1 == "" or num2 == "":
        return False

    for digit in num1:
        if digit < "0" or digit > "9":
            return False

    for digit in num2:
        if digit < "0" or digit > "9":
            return False

    return True


def readNumbers():
    try:
        with open("numere.txt", "r") as file:
            lines = file.readlines()

        if len(lines) != 2:
            print("The file must contain exactly 2 numbers")
            return

        num1 = lines[0].strip()
        num2 = lines[1].strip()

        if validateNumbers(num1, num2) == False:
            print("Inbalid numbers in file")
            return

        num1 = num1.lstrip("0")
        num2 = num2.lstrip("0")

        if num1 == "":
            num1 = "0"
        if num2 == "":
            num2 = "0"

        return num1, num2
        
    except FileNotFoundError:
        print("File not found.")
        return

def additionRtoL(num1, num2):
    len1 = len(num1) - 1
    len2 = len(num2) - 1

    carry = 0
    result = ""

    while len1 >= 0 or len2 >= 0 or carry > 0:
        dig1 = 0
        dig2 = 0

        if len1 >= 0:
            dig1 = int(num1[len1])

        if len2 >= 0:
            dig2 = int(num2[len2])

        total = dig1 + dig2 + carry
        result = str(total % 10) + result
        carry = total // 10

        len1 -= 1
        len2 -= 1
    return result.lstrip("0") or "0"

def multiplyByDigit(num, dig):
    carry = 0
    result = ""

    for i in range(len(num) -1, -1, -1):
        total = int(num[i]) * dig + carry

        result = str(total % 10) + result
        carry = total // 10

    if carry > 0:
        result = str(carry) + result

    return result

def multiplyNumbers(num1, num2):
    result = "0"
    pos = 0

    for i in range (len(num2) -1, -1, -1):
        digit = int(num2[i])

        partial = multiplyByDigit(num1, digit)

        for j in range(pos):
            partial = partial + "0"

        result = additionRtoL(result, partial)

        pos += 1

    return result

def main():
    numbers = readNumbers()

    if numbers == None:
        return

    num1 = numbers[0]
    num2 = numbers[1]

    print("First numbers: ", num1)
    print("second numbers: ", num2)

    print("Sum: ", additionRtoL(num1, num2))
    print("Product: ", multiplyNumbers(num1, num2))

main()
